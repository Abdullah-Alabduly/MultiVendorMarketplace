<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
     <title>@ViewBag.title</title>
	<link href="~/lib/bootstrap/css/bootstrap.css" rel="stylesheet" />
	<link href="~/lib/bootstrap/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="container">
    <nav class="navbar navbar-expand-lg bg-body-tertiary">
  <div class="container-fluid">
    <a class="navbar-brand" >Jadeed</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a asp-controller="Home" asp-action="Index" class="nav-link active" aria-current="page" >Home</a>
        </li>
        <li class="nav-item">
          <a asp-controller="Product" asp-action="Index" class="nav-link" >Products</a>
        </li>
        <li class="nav-item">
          <a asp-controller="Store" asp-action="Index" class="nav-link">Stores</a>
        </li>
       
      </ul>
    </div>
  </div>
</nav>
    <div class="container">
        @RenderBody()
    </div>
    @if (IsSectionDefined("Scripts"))
        {
             @await RenderSectionAsync("Scripts", true)
        }
       
</body>
</html>
