@model Product

<div class="card">
    <h5 class="card-header">Are you sure you want delete product</h5>
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>
        <p class="card-text">@Model.Price</p>
    </div>
    <div class="card-footer">
        <form asp-action="Delete" method="post">
            <input type="submit" value="Delete" class="btn btn-danger">
            <a asp-action="Details" asp-controller="Store" asp-route-id="@Model.StoreId" class="btn btn-primary">Back</a>
        </form>
    </div>
</div>