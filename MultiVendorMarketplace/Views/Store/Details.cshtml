@model Store
@{

    ViewBag.title = "Store Product";
}
<h1 class="text-center">@ViewBag.title</h1>
 <div>
    <a asp-action="Create" asp-controller="Product" asp-route-id="@Model.Id" class="btn btn-primary">Create New Product</a>
 </div>
 @if (Model.products!.Count != 0)
        {
<table class="table table-striped">
    <thead>
        <tr>
            <th>Id</th>
            <th>Name</th>
            <th>Price</th>
            <th>Edit</th>
            <th>Delete</th>
        </tr>
    </thead>
    <tbody>
       

            @foreach (var p in Model.products)
            {
                <tr>
                    <td>@p.Id</td>
                    <td>@p.Name</td>
                    <td>@p.Price</td>
                    <td><a asp-action="Update" asp-controller="Product" asp-route-id="@p.Id"  class="btn btn-primary">Edit</a></td>
                    <td><a asp-action="Delete" asp-controller="Product" asp-route-id="@p.Id" class="btn btn-danger">Delete</a></td>
                </tr>
            }

        
       
    </tbody>
</table>

  }else
    {
        <h3>No Products in This Store yet</h3>
    }